# Production environment for the Nori Docker stack (docker-compose.yml).
# Copy to docker/.env on the deployment host and fill in the values:
#   cp docker/.env.prod.example docker/.env

# --- Required secrets ---
POSTGRES_PASSWORD=CHANGE_ME
NORI_JWT_SECRET=CHANGE_ME            # e.g. openssl rand -hex 32
NORI_ADMIN_PASSWORD=CHANGE_ME        # first-login password; you'll be asked to change it

# --- Identity ---
NORI_ADMIN_EMAIL=admin@nori.dev
NORI_ACCOUNT_NAME=My Shop

# --- Networking ---
# The single host port the whole app is served on (web UI + API via Caddy).
NORI_HOST_PORT=8080

# --- Images ---
# latest = newest main build. Pin a git sha tag to roll back.
NORI_IMAGE_TAG=latest

# --- Uploads (optional overrides) ---
# MAX_UPLOAD_SIZE=1073741824
# ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/webm
