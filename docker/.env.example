# Docker Compose environment variables for Nori dev stack.
# Copy this file to docker/.env and fill in the values:
#   cp docker/.env.example docker/.env

# --- PostgreSQL ---
DB_HOST_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nori

# --- Nori Server ---
NORI_HOST_PORT=8081
MAX_UPLOAD_SIZE=1073741824
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/webm
NORI_JWT_SECRET=CHANGE_ME
NORI_ADMIN_EMAIL=admin@nori.dev
NORI_ADMIN_PASSWORD=CHANGE_ME
NORI_ACCOUNT_NAME=Nori Dev                # optional, defaults to "My Shop"
NORI_SKIP_PASSWORD_CHANGE=true            # skip forced password change on first login

# --- E2E Test Account (isolated from admin) ---
# When enabled, seeds a completely separate account + user + space for e2e tests.
E2E_ACCOUNT_ENABLED=true
E2E_ACCOUNT_EMAIL=e2e-test@nori.dev
E2E_ACCOUNT_PASSWORD=TestPass123!
