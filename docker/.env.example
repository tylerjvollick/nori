# Docker Compose environment variables for Nori dev stack.
# Copy this file to docker/.env and fill in the values:
#   cp docker/.env.example docker/.env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nori

# --- Nori Server ---
MAX_UPLOAD_SIZE=1073741824
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime,video/webm
NORI_JWT_SECRET=CHANGE_ME
NORI_ADMIN_EMAIL=admin@nori.dev
NORI_ADMIN_PASSWORD=CHANGE_ME
NORI_ACCOUNT_NAME=Nori Dev
