# E2E test environment — copy to .env.test and fill in your local admin credentials.
#
# The Playwright globalSetup uses the admin account to create a dedicated
# test user (e2e-test@nori.dev) on first run. Subsequent runs reuse it.

# Admin credentials (from your docker/.env)
NORI_ADMIN_EMAIL=admin@nori.dev
NORI_ADMIN_PASSWORD=CHANGE_ME

# Dedicated test user (created automatically by global-setup.ts)
NORI_TEST_EMAIL=e2e-test@nori.dev
NORI_TEST_PASSWORD=TestPass123!
